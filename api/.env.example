ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
ALLOWED_ORIGINS=http://localhost:5173
# 部署在反向代理後面時設為 1，才會用 X-Forwarded-For 做限流
TRUST_PROXY=0
MAX_USER_TURNS=20
CHAT_RATE_COUNT=30
CHAT_RATE_WINDOW=600
# 全站 Claude 用量上限：USAGE_WINDOW_SECONDS（預設 5 小時）內的總花費（美元）
USD_BUDGET=1.0
# 價格表（每百萬 tokens 美元），JSON；未設定時使用 api/usage.py 的 DEFAULT_PRICES
# PRICE_TABLE={"claude-sonnet-5-5": {"input": 2, "output": 10, "cache_write": 2.5, "cache_read": 0.2}}
USAGE_WINDOW_SECONDS=18000
