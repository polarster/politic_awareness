ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
ALLOWED_ORIGINS=http://localhost:5173
# 部署在反向代理後面時設為 1，才會用 X-Forwarded-For 做限流
TRUST_PROXY=0
MAX_USER_TURNS=20
CHAT_RATE_COUNT=30
CHAT_RATE_WINDOW=600
# 全站 Claude 用量上限：USAGE_WINDOW_SECONDS（預設 5 小時）內的總 token 數（輸入 + 快取 + 輸出）
TOKEN_BUDGET=2000000
USAGE_WINDOW_SECONDS=18000
