# 後端程式本身只讀 PA_ 開頭的設定（舊的 CLAUDE_EFFORT、CLAUDE_MODEL、TRUST_PROXY 等名稱已不再讀取）。
# Anthropic SDK 另外會讀 ANTHROPIC_ 開頭的變數（例如 ANTHROPIC_BASE_URL、ANTHROPIC_CUSTOM_HEADERS、ANTHROPIC_LOG），
# 所以請用 env -i 在乾淨的環境啟動（見 app.py 檔頭），並加 --no-access-log --no-proxy-headers --host 127.0.0.1。
# 後端不會自動讀這個檔：要用的設定請加在 env -i 後面。每一項的預設值與說明見 README〈後端設定〉。

# Anthropic 金鑰：放在檔案裡（chmod 600），不要寫在指令列。有設定時，金鑰只會來自這個檔案。
# 沒設定時改由 SDK 自己找：ANTHROPIC_API_KEY、ANTHROPIC_AUTH_TOKEN、ANTHROPIC_PROFILE、workload identity 的變數，
# 最後是 ~/.config/anthropic 的 profile（env -i 有帶 HOME，這一步仍然有效）。
PA_ANTHROPIC_API_KEY_FILE=../.keys/claude_api.key

PA_CLAUDE_MODEL=claude-sonnet-5-5
# 只接受 low、medium、high；其他值（例如 max）會拒絕啟動
PA_CLAUDE_EFFORT=medium
# 每次回覆的 max_tokens
PA_MAX_TOKENS=8000
# CORS 允許的前端來源（逗號分隔）；經 Vite proxy 呼叫 /api 時用不到，前端和 API 分開部署時才需要
PA_ALLOWED_ORIGINS=http://localhost:5173

# 反向代理放真實 client IP 的「單一」標頭，必須是代理一定會覆寫的那個：
# 經 Cloudflare（含 Tunnel）用 cf-connecting-ip，Fly.io 用 fly-client-ip。只有在後端只能經由該代理連到時才設定
# （例如目前的對外試用：cloudflared → Vite → 後端，前後端都只綁 127.0.0.1）；能直接連到後端的人可以自己填這個標頭。
# 沒設定時用連線的來源位址；這時經本機代理（Vite、cloudflared）進來的人會共用同一個限流 key。
# 不支援 X-Forwarded-For：它可以由使用者自己填。
# PA_CLIENT_IP_HEADER=cf-connecting-ip

# 每段對話使用者最多發言幾次（工具結果不算）
PA_MAX_USER_TURNS=20
# 整段對話的字數上限；UTF-8 位元組另以 3 倍為上限
PA_MAX_CHARS=60000
# 每個 client 的對答限流：PA_CHAT_RATE_WINDOW 秒內最多 PA_CHAT_RATE_COUNT 次
PA_CHAT_RATE_COUNT=30
PA_CHAT_RATE_WINDOW=600
# 全站同時進行的 Claude 呼叫上限（能分辨個別 client 時，同一個 client 同時只能有 1 個）
PA_MAX_CONCURRENT_CHATS=2
# /api/chat 請求 body 的位元組上限（最小 16384，在解析之前就擋下）。對話會帶著每一輪 thinking 的 signature，很長的對話被擋時可調高
PA_CHAT_MAX_BODY_BYTES=262144

# 全站 Claude 用量上限：PA_USAGE_WINDOW_SECONDS（預設 5 小時）內的總花費（美元）
PA_USD_BUDGET=1.0
# 前端用量條的「5 小時」文字是固定的，改這個值時畫面文字不會跟著變（後端的 429 訊息會跟著變）
PA_USAGE_WINDOW_SECONDS=18000
# 每個 client 在同一個視窗內最多用掉全站額度的幾分之幾（0.01–1）。要能分辨個別 client 才會套用（見 PA_CLIENT_IP_HEADER）。
# 預設 0.2 × $1 = 每 5 小時 $0.20。以目前的 system prompt 估算，一次請求約 $0.016（快取命中）到 $0.085（未命中），
# 大約只夠 10 次上下的請求（快取失效時更少；回應完工具建議卡、送回結果也算一次）。
# 同一個公網 IP（電信 CGNAT、辦公室）或同一個 IPv6 /64 的人共用這份額度。
# 要放寬可以調高這個比例或 PA_USD_BUDGET。
PA_CLIENT_BUDGET_FRACTION=0.2
# 價格表（每百萬 tokens 美元），JSON；未設定時使用 api/usage.py 的 DEFAULT_PRICES。
# 新增模型時四個欄位都要給，缺欄位或負數會拒絕啟動
# PA_PRICE_TABLE={"claude-sonnet-5-5": {"input": 2, "output": 10, "cache_write": 2.5, "cache_read": 0.2}}

# 每天（UTC）最多新增幾筆匿名作答，超過回 429。重送同一份作答會覆蓋原本那一筆，不會被每日上限擋下；
# 但跨日重送時，那一筆的日期會改成當天，因此算進當天的筆數
PA_LOG_DAILY_LIMIT=500

# 檔案位置。相對路徑以啟動時的工作目錄為準；不設定時用 repo 裡的預設位置（api/ 底下的兩個資料庫、web/src/generated/data.json）。
# 資料庫檔會以 0600 建立；建議放在 0700 的專用目錄，作答與用量兩個資料庫最好分開放
# PA_DATA_PATH=../web/src/generated/data.json
# PA_LOG_DB_PATH=./answers.sqlite3
# PA_USAGE_DB_PATH=./usage.sqlite3
